# Auto detect text files and perform LF normalization
* text=auto

# Preserve audited v2 artifact bytes so manifest checksums survive platform changes.
results/followup_v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Data-study CSV/JSON hashes also describe exact generated bytes.
results/data_study/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Adaptive-study evidence and historical manifests cover exact generated bytes.
results/adaptive_learning/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Residual-study hashes describe generated artifact bytes, including Windows CSV newlines.
results/residual_state_space/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Registered attempts and reviewed operational evidence retain exact generated bytes.
results/operational_learning/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/experiment_registry.jsonl -text
